# Copy to .env.local and fill in the values. Never commit .env.local.

# ── Database (Aiven PostgreSQL) ───────────────────────────────────────────────
# Aiven console → your service → Connection information → Service URI.
# sslmode=require is handled by the app; tables are created automatically on first run.
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth (optional — the button only appears when both are set)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google  (and http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Site owner ────────────────────────────────────────────────────────────────
# The account with this email is the blog admin (Google or password login).
ADMIN_EMAIL="rameshkumarana@gmail.com"
# Initial admin password for email/password login. Seeded on first run; change it in /admin/settings.
ADMIN_PASSWORD=""
# Public origin — used for canonical URLs, OG images, sitemap and links inside emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email (contact-form alerts, newsletter welcome + new-post emails) ─────────
# If nothing is configured, emails are skipped and logged to the console.
#
# Option A — Gmail SMTP (default for this site; no custom domain needed).
#   Google Account → Security → 2-Step Verification → App passwords → create one ("Mail").
#   SMTP_PASS is the 16-character app password, NOT your Gmail password. Spaces are ignored.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="rameshkumarana@gmail.com"
SMTP_PASS=""
SMTP_SECURE="false"
#
# Option B — Resend (https://resend.com). Only useful with a domain verified in Resend;
# without one Resend delivers solely to the account owner's inbox. SMTP wins if both are set.
RESEND_API_KEY=""
#
# Sender identity. For Gmail use the same address as SMTP_USER (Gmail rewrites anything else).
MAIL_FROM="A Ramesh Kumaran <rameshkumarana@gmail.com>"
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL="rameshkumarana@gmail.com"

# ── Optional integrations ─────────────────────────────────────────────────────
# GitHub personal token (raises rate limits for the live GitHub widget on the home page)
GITHUB_TOKEN=""
